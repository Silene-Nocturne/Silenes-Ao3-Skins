  color: #0000001a; /* change border color here */
  background:
url("https://64.media.tumblr.com/0ec2ca3defd640d2c894c9214768196f/75b7c358194c48a2-ad/s75x75_c1/51e66fc2210d31d249538b065b026be78a45b09e.png"), /* url of new icon */
    #A4A49D; /* change lock color here */
  font-size: 0;
}

/* fix private bookmark */
.status .private .text {
  background: none;
}

/* Hidden bookmark */
.status .hidden,
img[src$="/images/skins/iconsets/default/bookmark-hidden.png"] {
  color: #0000001a; /* change border color here */
  background:
url("https://64.media.tumblr.com/0ec2ca3defd640d2c894c9214768196f/75b7c358194c48a2-ad/s75x75_c1/51e66fc2210d31d249538b065b026be78a45b09e.png"), /* url of new icon */
    #83343D; /* change lock color here */
}

/*>========== RSS ICON ==========<*/

/* hide old rss icon */
a.rss span {
  padding: 0;
  background: none;
}

/* setup for the new rss icon */
.actions li a.rss {
  display: inline-flex;
    align-content: center;
    align-items: center;
    column-gap: 0.3em;
}

/* new rss icon */
.actions li a.rss::before {
  box-sizing: border-box;
  width: 0.85em;
  height: 0.85em;
  border: 1px solid var(--icon-border1);
  border-radius: 2px;
  background:
url("https://64.media.tumblr.com/f12c868828de747f6e7e2d9bfbdc2d7b/7d4bf8d00b850009-32/s75x75_c1/a5aaf7577599b12da85b453711b44667b57d0ab9.png") /* url of new icon */
     #B57E59; /* change background color here */
  background-size: cover;
  content: "";
}

/*>========== LOCK ICON for restricted works ==========<*/

/* only visible for logged in users */
img[src$="/images/lockblue.png"] {
  content: url("https://64.media.tumblr.com/2d4e7c1776d213c841b67b96cb74f04d/5c468793e75ee386-01/s75x75_c1/50861b3dce3ca429fad165e53b3a9000642e5e36.png"); /* url of new icon */
}

/* hidden by admin */
img[src$="/images/lockred.png"] {
  content: url("https://64.media.tumblr.com/98bef0f1217e454070172228cd6aca37/55f49fbf8ad947f2-84/s75x75_c1/9f836864d6531c48c6aac610ba562fbd4c65f8f6.png"); /* url of new icon */
}



